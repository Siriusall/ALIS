# 复制为项目根目录 .env 后填写（backend 启动时会自动读取）
# cp .env.example .env

# TuShare / 掘金数据 Token（必填，否则 POST /api/init 无法拉行情）
TUSHARE_TOKEN=

# PostgreSQL 是唯一运行数据库。主业务库与数据中台使用独立数据库。
DATABASE_URL=postgresql://alis_app:change-me@127.0.0.1:5432/alis_sim
DATA_PLATFORM_DATABASE_URL=postgresql://alis_app:change-me@127.0.0.1:5432/alis_data
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# 生产环境必须修改密钥，并显式限制允许访问后端的前端地址。
JWT_SECRET=change-this-before-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
