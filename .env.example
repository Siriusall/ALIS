# 复制为项目根目录 .env 后填写（backend 启动时会自动读取）
# cp .env.example .env

# TuShare / 掘金数据 Token（必填，否则 POST /api/init 无法拉行情）
TUSHARE_TOKEN=

# PostgreSQL 是唯一运行数据库。主业务库与数据中台使用独立数据库。
DATABASE_URL=postgresql://alis_app:change-me@127.0.0.1:5432/alis_sim
DATA_PLATFORM_DATABASE_URL=postgresql://alis_app:change-me@127.0.0.1:5432/alis_data
DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Process-local caps for short-lived PostgreSQL connections. Both URLs above
# point at the same PostgreSQL cluster, so max_connections=30 (3 reserved for
# superusers) is shared by alis_sim and alis_data and by API/control/research.
# Keep these conservative defaults (4 business + 3 data connections per
# process); set values explicitly in every service environment rather than
# raising one process cap in isolation.
ALIS_BUSINESS_DB_MAX_CONNECTIONS=4
ALIS_DATA_DB_MAX_CONNECTIONS=3

# Shared console reads: PostgreSQL is authoritative and Redis holds only a
# short-lived mirror.  Values are fallback refresh periods; task/data writes
# actively invalidate the affected page snapshots.
ALIS_CONSOLE_SNAPSHOT_OVERVIEW_TTL_SECONDS=30
ALIS_CONSOLE_SNAPSHOT_DECISION_TTL_SECONDS=30
ALIS_CONSOLE_SNAPSHOT_PORTFOLIO_TTL_SECONDS=30
ALIS_CONSOLE_SNAPSHOT_OPERATIONS_TTL_SECONDS=15
ALIS_CONSOLE_SNAPSHOT_DATA_TTL_SECONDS=60
ALIS_CONSOLE_SNAPSHOT_MODELS_TTL_SECONDS=300
# Emergency cross-account traffic protection. Historical audits reuse the
# last durable summary; optional workers stop claiming new heavy work after
# the host reaches its daily interface budget. Trading-day production tasks
# remain eligible so the main pipeline does not silently stop.
ALIS_CONSOLE_SNAPSHOT_HISTORICAL_AUDIT_MODE=persisted
ALIS_NETWORK_BUDGET_ENABLED=1
ALIS_NETWORK_DAILY_BUDGET_MB=1024
ALIS_NETWORK_BUDGET_INTERFACE=eth0
ALIS_NETWORK_BUDGET_DIRECTION=total
ALIS_NETWORK_BUDGET_STATE_PATH=/var/lib/alis-network-budget/state.json

# 生产环境必须修改密钥，并显式限制允许访问后端的前端地址。
JWT_SECRET=change-this-before-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Independent close-of-day data update (local time).
ALIS_DAILY_UPDATE_ENABLED=1
ALIS_DAILY_UPDATE_HOUR=15
ALIS_DAILY_UPDATE_MINUTE=1
ALIS_DAILY_UPDATE_INTERVAL_SEC=60
MARKET_BULK_DEFAULT_ETA_MS=12000
MARKET_BULK_HEDGE_MIN_SECONDS=3
MARKET_BULK_HEDGE_MAX_SECONDS=20
MARKET_BULK_HEDGE_ADVANTAGE_MS=1500
MARKET_BULK_HARD_TIMEOUT_SECONDS=120
MARKET_PROVIDER_CIRCUIT_FAILURES=3
ALIS_DAILY_RESEARCH_LIMIT=100

# Continuous challenger training and automatic gated promotion.
# The daily governance tick starts a new run only when market data advanced
# and the minimum retraining interval elapsed. Failed jobs retry after cooldown.
ALIS_MODEL_GOVERNANCE_SCHEDULER_ENABLED=1
ALIS_MODEL_GOVERNANCE_INTERVAL_SECONDS=86400
ALIS_MODEL_RETRAIN_INTERVAL_HOURS=168
ALIS_MODEL_FAILED_RETRY_HOURS=24
ALIS_MODEL_TRAIN_STALE_HOURS=12

# HSMM must observe live shadow predictions before review.
HSMM_MINIMUM_LIVE_OBSERVATION_WEEKS=4

# LLM review assistant (fill DEEPSEEK_API_KEY locally; never commit a real key).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_TOKENS_PER_REQUEST=1200
DEEPSEEK_DAILY_TOKEN_BUDGET=10000000
DEEPSEEK_MAX_INPUT_CHARS=16000
DEEPSEEK_TRIAGE_MAX_ITEMS_PER_CYCLE=10

# 独立系统告警 Worker。收件人固定为 siriusal@icloud.com，密码只放生产环境文件。
ALIS_ALERT_INTERVAL_SECONDS=60
ALIS_ALERT_HEALTH_URL=https://www.xlytism.com/api/health
ALIS_ALERT_PLAN_DEADLINE_HOUR=18
ALIS_ALERT_PLAN_DEADLINE_MINUTE=30
# 优先复用参考告警系统的 Resend 投递；为空时才回退 SMTP。
ALIS_ALERT_RESEND_API_KEY=
ALIS_ALERT_RESEND_FROM="ALIS 系统告警 <onboarding@resend.dev>"
ALIS_ALERT_SMTP_HOST=smtpdm.aliyun.com
ALIS_ALERT_SMTP_PORT=465
ALIS_ALERT_SMTP_SECURE=true
ALIS_ALERT_SMTP_USER=noreply@mail.xlytism.com
ALIS_ALERT_SMTP_PASS=
ALIS_ALERT_SMTP_FROM=noreply@mail.xlytism.com
ALIS_ALERT_SMTP_FROM_NAME=ALIS 系统告警
