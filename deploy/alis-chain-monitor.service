[Unit]
Description=ALIS three-node chain monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/alis/chain-monitor.env
ExecStartPre=/usr/local/sbin/alis-chain-monitor-config-check
ExecStart=/usr/local/libexec/alis-chain-monitor.py
User=root
StateDirectory=alis-chain-monitor
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077
TimeoutStartSec=60
