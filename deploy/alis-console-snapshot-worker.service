[Unit]
Description=ALIS Console Snapshot Control Worker
After=network-online.target wg-quick@wg0.service
Wants=network-online.target wg-quick@wg0.service

[Service]
Type=simple
WorkingDirectory=/opt/alis-worker/backend
EnvironmentFile=/etc/alis/worker.env
Environment=PYTHONPATH=/opt/alis-worker/backend
Environment=ALIS_WORKER_POOL=control
# This is a fourth process against the same 30-session PostgreSQL cluster as
# the API, control and research workers.  Keep its own short-lived connection
# allowance below the shared worker.env defaults so enabling snapshot prewarm
# cannot exhaust the cluster during a data-platform recovery.
Environment=ALIS_BUSINESS_DB_MAX_CONNECTIONS=2
Environment=ALIS_DATA_DB_MAX_CONNECTIONS=2
Environment=DATABASE_CONNECT_TIMEOUT_SECONDS=5
Environment=DATABASE_STATEMENT_TIMEOUT_MS=30000
Environment=DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
Environment=ALIS_CONSOLE_SNAPSHOT_HISTORICAL_AUDIT_MODE=persisted
Environment=ALIS_NETWORK_BUDGET_ENABLED=1
Environment=ALIS_NETWORK_DAILY_BUDGET_MB=128
Environment=ALIS_NETWORK_BUDGET_INTERFACE=eth0
Environment=ALIS_NETWORK_BUDGET_DIRECTION=tx
Environment=ALIS_NETWORK_BUDGET_STATE_PATH=/var/lib/alis-worker/network-budget.json
ExecStart=/opt/alis-worker/backend/.venv/bin/python -m app.console_snapshot_worker_main
Restart=always
RestartSec=10
User=root
StateDirectory=alis-worker
NoNewPrivileges=true
PrivateTmp=true
Nice=10
MemoryHigh=850M
MemoryMax=1100M
TasksMax=128

[Install]
WantedBy=multi-user.target
