[Unit]
Description=ALIS Console Snapshot Control Worker
After=network-online.target wg-quick@wg0.service
Wants=network-online.target wg-quick@wg0.service

[Service]
Type=simple
WorkingDirectory=/opt/alis-worker/backend
EnvironmentFile=/etc/alis/worker.env
Environment=PYTHONPATH=/opt/alis-worker/backend
Environment=ALIS_WORKER_POOL=control
ExecStart=/opt/alis-worker/backend/.venv/bin/python -m app.console_snapshot_worker_main
Restart=always
RestartSec=10
User=root
NoNewPrivileges=true
PrivateTmp=true
Nice=10
MemoryHigh=850M
MemoryMax=1100M
TasksMax=128

[Install]
WantedBy=multi-user.target
